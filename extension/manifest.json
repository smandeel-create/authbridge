{
  "manifest_version": 3,
  "name": "AuthBridge",
  "version": "0.1.0",
  "description": "Fills logins in tabs on request from the local AuthBridge daemon. Credentials are approved on the user's iPhone.",
  "key": "",
  "permissions": ["nativeMessaging", "scripting", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" }
}
